# Python caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Runtime process and Streamlit logs
*.pid
streamlit_app.out.log
streamlit_app.err.log
streamlit_app_*.out.log
streamlit_app_*.err.log
streamlit_stdout.log
streamlit_stderr.log

# Runtime logs
logs/*.log
logs/*.jsonl

# Private/generated local data
.learnings/
data/chat_history.json
data/response_preferences.json
data/user_profile.json
data/reality_grounding_patterns.json
data/search_cache/
data/search_history/
data/web_research/
data/research_reports/
data/images/
data/knowledge_notes/
data/agent/

# Generated knowledge indexes
ai_system/knowledge_bank/web_research/embeddings.json
ai_system/knowledge_bank/web_research/chunks.json
ai_system/knowledge_bank/web_research/metadata.json

# Audit/progress/build artifacts
audit/
progress/
build/
dist/

# Local secrets (API keys). Keep .env.example tracked as the template.
.env
.env.*
!.env.example

# Leftover temp files from an interrupted atomic save (modules/file_utils.py)
.*.tmp
# Lock files, pre-migration backups and set-aside damaged files next to saved data
*.json.lock
*.jsonl.lock
data/*.backup.json
data/*.damaged-*
# Local snapshots and backup files hold copies of private data
data/_snapshots/
*.cnbackup
cognitive_nexus_export_*.zip
