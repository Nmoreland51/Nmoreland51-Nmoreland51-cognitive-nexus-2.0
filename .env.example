OLLAMA_URL=http://localhost:11434
COMFYUI_URL=http://127.0.0.1:8188

# Optional cloud providers. Leave unset for local/offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional local Transformers provider. This loads lazily and may be heavy.
HF_LOCAL_MODEL=

# Optional knowledge embeddings. Default "hash" is local and dependency-light.
# Set to "sentence_transformers" after installing sentence-transformers if you want all-MiniLM-L6-v2 style embeddings.
KNOWLEDGE_EMBEDDING_BACKEND=hash
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bloodhound Search Mode
ENABLE_REALITY_GROUNDING=true
SHOW_GROUNDING_NOTES=true
ENABLE_REALITY_FIRST_REASONING=true
ENABLE_REALITY_RESEARCH_AGENT=true
EPISTEMIC_MODE=auto
ENABLE_BLOODHOUND_SEARCH=true
ENABLE_ONION_SEARCH=false
TOR_SOCKS_PROXY=127.0.0.1:9050
MAX_SEARCH_RESULTS=50
SEARCH_TIMEOUT_SECONDS=20
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_HOURS=24
ENABLE_LINK_FOLLOWING=true
