OLLAMA_URL=http://localhost:11434
# Seconds to wait for Ollama's first streamed token before falling back (CPU-only machines need more).
OLLAMA_MIN_READ_TIMEOUT=120
COMFYUI_URL=http://127.0.0.1:8188

# Web search sources, tried in this order. The app switches to the next one automatically when a
# source errors, is rate-limited or finds nothing; one that errors is skipped for 5 minutes.
# Sources that aren't set up are skipped. Free search pages (ddgs) often get rate-limited.
SEARCH_SOURCES=searxng,brave,ddgs,wikipedia
# Your own SearXNG server, e.g. http://localhost:8888 (enable "json" under search.formats in its settings.yml).
SEARXNG_URL=
# Brave Search API key from https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Language for the Wikipedia fallback.
WIKIPEDIA_LANG=en
# Research refuses to fetch pages on this machine or your private network (localhost, 192.168.x.x,
# 10.x.x.x ...), including through redirects. Set to true only to ingest pages from your own network.
ALLOW_PRIVATE_URL_FETCH=false

# Optional cloud providers. Leave unset for local/offline mode.
# A cloud provider receives your prompt, including any memory or document text placed in it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# Current Claude models: claude-sonnet-5-5 (default), claude-opus-5-5 (stronger, about twice the
# price), claude-haiku-5-5 (fastest and cheapest). Retired IDs are replaced automatically.
ANTHROPIC_MODEL=claude-sonnet-5-5
# How much thinking Claude does before answering: low, medium, high, xhigh or max.
ANTHROPIC_EFFORT=low
# false (default): if the local model fails the app says so and nothing is sent to a cloud
# provider. A cloud provider placed FIRST in the provider order is always used.
# true: a configured cloud provider lower in the order may answer when the local model fails.
ALLOW_CLOUD_FALLBACK=false

# Optional local Transformers provider. This loads lazily and may be heavy.
HF_LOCAL_MODEL=

# Optional knowledge embeddings. Default "hash" is local and dependency-light.
# Set to "sentence_transformers" after installing sentence-transformers if you want all-MiniLM-L6-v2 style embeddings.
KNOWLEDGE_EMBEDDING_BACKEND=hash
KNOWLEDGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bloodhound Search Mode
ENABLE_REALITY_GROUNDING=true
SHOW_GROUNDING_NOTES=true
ENABLE_REALITY_FIRST_REASONING=true
ENABLE_REALITY_RESEARCH_AGENT=true
EPISTEMIC_MODE=auto
ENABLE_BLOODHOUND_SEARCH=true
ENABLE_ONION_SEARCH=false
TOR_SOCKS_PROXY=127.0.0.1:9050
MAX_SEARCH_RESULTS=50
SEARCH_TIMEOUT_SECONDS=20
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_HOURS=24
ENABLE_LINK_FOLLOWING=true
